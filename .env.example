# Salin file ini menjadi `.env` lalu isi nilainya.
# Jangan pernah commit file `.env` (sudah di-gitignore).

# Koneksi database (MySQL / MariaDB). Untuk Aiven/cloud wajib TLS aktif:
#   mysql://<user>:<pass>@<host>:<port>/<database>?ssl=true
DATABASE_URL="mysql://user:password@localhost:3306/tobak_os"

# Next Auth - wajib diset (string acak). Pakai nilai yang sama di Vercel.
AUTH_SECRET="generate-string-acak"

# Pada Vercel tidak perlu diset (otomatis via VERCEL=1).
# Di luar Vercel (VPS/deploy lokal): set "true" untuk trust host.
AUTH_TRUST_HOST=true

# Opsional: path biner mysqldump/mariadb-dump untuk fitur Backup Database.
# Jika tidak diset, aplikasi mencari otomatis di PATH & direktori umum.
# Di Vercel (serverless) otomatis memakai fallback dump via Prisma.
# MYSQLDUMP_PATH=C:\Program Files\MariaDB 12.3\bin\mysqldump.exe
# MYSQLDUMP_PATH=/usr/bin/mariadb-dump

# Opsional: SSL ke database cloud (Aiven MySQL dll) dengan verifikasi CA.
# Isi DATABASE_SSL_CA dengan isi file PEM, atau versi base64-nya
# (base64 disarankan untuk env Vercel karena multi-line PEM sulit ditempel).
# DATABASE_SSL_CA=
# DATABASE_SSL_VERIFY=false   # default true; false = tanpa verifikasi CA

# Opsional: URL development (pakai https saat `npm run dev:https`)
# AUTH_URL=http://localhost:3000
# NEXTAUTH_URL=http://localhost:3000